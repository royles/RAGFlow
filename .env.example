# Optional. Blank AWS keys are ignored so an instance role still works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Optional fallbacks for the OpenAI client API. The Models page can set these instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Leave empty to store vectors in data/qdrant.
QDRANT_URL=
QDRANT_API_KEY=

# Most chunks one upload may produce. 0 means no limit.
RAGFLOW_MAX_CHUNKS=5000

# Delete audited answers older than this many days at startup. 0 keeps everything.
RAGFLOW_AUDIT_RETENTION_DAYS=0

# Extra Host headers allowed to call /mcp, comma-separated.
RAGFLOW_MCP_ALLOWED_HOSTS=
