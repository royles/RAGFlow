# Optional. Blank AWS keys are ignored so an instance role still works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Leave empty to store vectors in data/qdrant.
QDRANT_URL=
QDRANT_API_KEY=

# Extra Host headers allowed to call /mcp, comma-separated.
RAGFLOW_MCP_ALLOWED_HOSTS=
